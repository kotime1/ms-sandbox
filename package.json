{
  "name": "ms-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hands-on mock Microsoft Sentinel lab environment for SC-200 study. Mimics the portal workflow; does not replicate Sentinel.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "e2e": "node scripts/e2e-all.mjs",
    "progress": "node scripts/progress.mjs",
    "coverage": "node scripts/coverage.mjs"
  },
  "license": "UNLICENSED"
}
