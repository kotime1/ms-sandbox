# Copy to .env and run with:  npm start   (it loads .env by itself; a missing .env is fine)
# Nothing here is required. Defaults are secure-by-default for a single learner on localhost.

# Interface to bind. Non-loopback values are refused unless ALLOW_REMOTE=1.
HOST=127.0.0.1
PORT=3000
# ALLOW_REMOTE=1

# Set to 1 when serving over HTTPS (adds the Secure flag to the session cookie).
# COOKIE_SECURE=1

# Claude, through IBM Consulting Advantage (ICA). Everything works offline without these.
# Key: ICA UI > Settings > API Keys > ICA APIs. It is read from the environment only and is sent only to the ICA API
# (as a Bearer token); it is never sent to the browser, put in a prompt, or logged.
# Model: ICA chat-model ids are tenant-specific, so none is assumed. Run `node --env-file=.env scripts/ica-models.mjs`
# to list the Claude ids your key can use, then set ICA_MODEL.
# ICA_API_KEY=
# ICA_MODEL=
# ICA_BASE_URL=https://api.servicesessentials.ibm.com/v1

# Assistant agent (answers questions during a lab). Offline from the built-in lab notes unless ICA is configured.
# ASSISTANT_PROVIDER=local        # force offline mode even if ICA is configured
# ASSISTANT_MODEL=                # optional: a different (e.g. smaller) model than ICA_MODEL for the assistant

# Practice exam. The built-in question bank works offline. With ICA configured, a learner can also ask for freshly
# written questions (about 40% of an exam) when starting an exam. Every generated question must pass the same
# answer-shape checks as the built-in ones, or it is discarded.
# EXAM_PROVIDER=local             # never write questions with Claude, even if ICA is configured
# EXAM_MODEL=                     # optional: a different (e.g. stronger) model than ICA_MODEL for question writing
