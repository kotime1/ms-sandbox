# Copy to .env and run with:  npm start   (it loads .env by itself; a missing .env is fine)

###################################
# Server
###################################

HOST=127.0.0.1
PORT=3000
# ALLOW_REMOTE=1 # Enable for non-loopback values
# COOKIE_SECURE=1 # Set to 1 when serving over HTTPS

###################################
# ICA MODEL
# Run `node --env-file=.env scripts/probe-ica.mjs models` to list available models
###################################

# ICA_API_KEY=
# ICA_MODEL=
# ICA_BASE_URL=https://api.servicesessentials.ibm.com/v1

###################################
# Assistant agent
###################################

# ASSISTANT_PROVIDER=local
# ASSISTANT_MODEL=

###################################
# Exam agent
###################################

# EXAM_PROVIDER=local
# EXAM_MODEL=
# EXAM_TUTOR_MODEL=
