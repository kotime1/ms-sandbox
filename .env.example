# Copy to .env and run with:  node --env-file=.env server/index.js
# Nothing here is required. Defaults are secure-by-default for a single learner on localhost.

# Interface to bind. Non-loopback values are refused unless ALLOW_REMOTE=1.
HOST=127.0.0.1
PORT=3000
# ALLOW_REMOTE=1

# Set to 1 when serving over HTTPS (adds the Secure flag to the session cookie).
# COOKIE_SECURE=1

# Assistant agent. With no key it runs fully offline using the built-in lab notes.
# The key is read from the environment only; it is never sent to the browser or logged.
# ANTHROPIC_API_KEY=
# ASSISTANT_PROVIDER=local        # force offline mode even if a key is present
# ASSISTANT_MODEL=claude-haiku-5-5
